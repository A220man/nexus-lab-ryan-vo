# nexus-lab-ryan-vo Environment Configuration
# Copy to .env and fill in values

# Database (PostgreSQL for production, SQLite for development)
# DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus_lab
DATABASE_URL=sqlite:///./data.db

# Secret key for session signing (generate with: openssl rand -hex 32)
SECRET_KEY=

# Keycloak OIDC Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=nexus-lab
KEYCLOAK_CLIENT_ID=nexus-lab
KEYCLOAK_CLIENT_SECRET=

# LLM Provider Configuration
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ChromaDB Vector Store
CHROMA_URL=http://localhost:8001

# Demo Mode (local development only - binds to 127.0.0.1, refuses in production)
DEMO_MODE=false

# Application
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO